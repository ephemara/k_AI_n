// ============================================================================
//  k_AI_n :: _common.kn — The Core Substrate, Memory Arenas & DMA Foundation
// ============================================================================
//  Filename note: The leading underscore guarantees `_common.kn` sorts FIRST
//  in ASCII alphabetical order ('_' < 'a') during whole-program amalgamation
//  (`kain amalgamate --raw kain/core -o kain/core.kn`).
//
//  Every core neural module relies on the foundational primitives defined here:
//    - Bounded arena allocators with +32 byte SIMD safety padding.
//    - Low-level byte, float, and int pointer window accessors (bref, bstore, fref, etc.).
//    - High-throughput kernel32 DMA file streaming (77x faster file_read).
//    - Common Tensor1D, Tensor2D, TernaryMatrix, and TokenBuffer views.
//    - Invariant verification laws (bounds checks, alignment, finiteness).
//    - Tab/newline-safe string, integer, and floating-point parsing.
//
//  DESIGN RULES:
//    * All symbols are `pub`.
//    * Memory allocators enforce the +32 SIMD padding rule without exception.
//    * Stateless: No global world/patch/pulse state lives in _common.
// ============================================================================

use std::runtime
use std::text
use std::bytes
use std::fs
use std::process

// ============================================================================
//  1. Architecture & Execution Constants
// ============================================================================

pub const EXIT_OK: Int = 0
pub const EXIT_HELP: Int = 1
pub const EXIT_ERROR: Int = 2

pub const SIMD_ALIGN_BYTES: Int = 32
pub const CACHE_LINE_BYTES: Int = 64

pub const MODEL_DIM_DEFAULT: Int = 4096
pub const MODEL_STATE_DIM: Int = 128
pub const MODEL_VOCAB_SIZE: Int = 16384
pub const MAX_SEQUENCE_LENGTH: Int = 8192

// Windows File Access & Share Constants
pub const GEN_READ: Int = 2147483648
pub const GEN_WRITE: Int = 1073741824
pub const OPEN_EXISTING: Int = 3
pub const CREATE_ALWAYS: Int = 2
pub const FILE_NORMAL: Int = 128
pub const FILE_SHARE_RW: Int = 3

// ============================================================================
//  2. High-Throughput OS DMA Streaming (kernel32 FFI)
// ============================================================================

@extern @link_name("CreateFileA")
pub fn k_CreateFileA(name: String, access: Int, sharemode: Int, sec: ptr<Void>, disp: Int, flags: Int, tmpl: ptr<Void>) -> ptr<Void>

@extern @link_name("GetFileSizeEx")
pub fn k_GetFileSizeEx(h: ptr<Void>, outsz: ptr<Int>) -> Int

@extern @link_name("SetFilePointer")
pub fn k_SetFilePointer(h: ptr<Void>, lo: Int, hi: ptr<Int>, method: Int) -> Int

@extern @link_name("ReadFile")
pub fn k_ReadFile(h: ptr<Void>, buf: ptr<Byte>, n: Int, outn: ptr<Int>, ov: ptr<Void>) -> Int

@extern @link_name("WriteFile")
pub fn k_WriteFile(h: ptr<Void>, buf: ptr<Byte>, n: Int, outn: ptr<Int>, ov: ptr<Void>) -> Int

@extern @link_name("CloseHandle")
pub fn k_CloseHandle(h: ptr<Void>) -> Int

@extern @link_name("GetLastError")
pub fn k_GetLastError() -> Int

pub fn null_ptr() -> ptr<Void> with Pure:
    return int_to_ptr(0, "ptr<Void>")

pub fn k_open_read(path: String) -> ptr<Void> with Unsafe:
    return k_CreateFileA(path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())

pub fn k_open_write(path: String) -> ptr<Void> with Unsafe:
    return k_CreateFileA(path, GEN_WRITE, FILE_SHARE_RW, null_ptr(), CREATE_ALWAYS, FILE_NORMAL, null_ptr())

pub fn k_handle_bad(h: ptr<Void>) -> Bool with Pure:
    return ptr_to_int(h) == -1 or ptr_to_int(h) == 0

// Reads an entire file directly into a contiguous Byte arena with +32 SIMD padding.
// Returns the arena pointer, or null_ptr() on failure.
pub fn dma_read_file(path: String, out_size: ptr<Int>) -> ptr<Byte> with Unsafe:
    let h = k_open_read(path)
    if k_handle_bad(h):
        mem_store(out_size, 0, "Int")
        return int_to_ptr(0, "ptr<Byte>")

    let sz_slot: ptr<Int> = alloc_zeroed(8, "Int")
    let sz_ok = k_GetFileSizeEx(h, sz_slot)
    let nbytes = mem_load(sz_slot, "Int")
    decay sz_slot

    if sz_ok == 0 or nbytes <= 0:
        k_CloseHandle(h)
        mem_store(out_size, 0, "Int")
        return int_to_ptr(0, "ptr<Byte>")

    // Allocate arena with +32 SIMD padding
    let mut buf: ptr<Byte> = alloc_zeroed(nbytes + SIMD_ALIGN_BYTES, "Byte")
    let nread_slot: ptr<Int> = alloc_zeroed(8, "Int")
    let rd_ok = k_ReadFile(h, buf, nbytes, nread_slot, null_ptr())
    let bytes_read = mem_load(nread_slot, "Int")
    decay nread_slot
    k_CloseHandle(h)

    if rd_ok == 0 or bytes_read != nbytes:
        decay buf
        mem_store(out_size, 0, "Int")
        return int_to_ptr(0, "ptr<Byte>")

    mem_store(out_size, nbytes, "Int")
    return buf

// Writes a memory arena directly to disk via kernel32.
pub fn dma_write_file(path: String, buf: ptr<Byte>, nbytes: Int) -> Bool with Unsafe:
    let h = k_open_write(path)
    if k_handle_bad(h):
        return false

    let nwritten_slot: ptr<Int> = alloc_zeroed(8, "Int")
    let wr_ok = k_WriteFile(h, buf, nbytes, nwritten_slot, null_ptr())
    let bytes_written = mem_load(nwritten_slot, "Int")
    decay nwritten_slot
    k_CloseHandle(h)

    return wr_ok != 0 and bytes_written == nbytes

// ============================================================================
//  3. Memory Arena Allocators (+32 SIMD Safety Rule)
// ============================================================================

// Allocates an arena for N bytes with +32 SIMD overrun safety padding.
pub fn arena_alloc_bytes(n_bytes: Int) -> ptr<Byte> with Unsafe:
    var sz = n_bytes
    if sz < 0:
        sz = 0
    return alloc_zeroed(sz + SIMD_ALIGN_BYTES, "Byte")

// Allocates an arena for N 64-bit integers with +8 element safety padding.
pub fn arena_alloc_ints(n_ints: Int) -> ptr<Int> with Unsafe:
    var count = n_ints
    if count < 0:
        count = 0
    return alloc_zeroed(count + 8, "Int")

// Allocates an arena for N 64-bit floats with +8 element safety padding.
pub fn arena_alloc_floats(n_floats: Int) -> ptr<Float> with Unsafe:
    var count = n_floats
    if count < 0:
        count = 0
    return alloc_zeroed(count + 8, "Float")

// ============================================================================
//  4. Pointer Window Load/Store Primitives
// ============================================================================

// Read byte `i` as Int (0..255).
pub fn bref(buf: ptr<Byte>, i: Int) -> Int with Unsafe:
    return mem_load(ptr_offset(buf, i, "Byte"), "Int") & 255

// Store byte `i` (0..255).
pub fn bstore(buf: ptr<Byte>, i: Int, v: Int) with Unsafe:
    mem_store(ptr_offset(buf, i, "Byte"), v as Byte, "Byte")

// Read 64-bit Float at index `i`.
pub fn fref(buf: ptr<Float>, i: Int) -> Float with Unsafe:
    return mem_load(ptr_offset(buf, i, "Float"), "Float") as Float

// Store 64-bit Float at index `i`.
pub fn fstore(buf: ptr<Float>, i: Int, v: Float) with Unsafe:
    mem_store(ptr_offset(buf, i, "Float"), v, "Float")

// Read 64-bit Int at index `i`.
pub fn iref(buf: ptr<Int>, i: Int) -> Int with Unsafe:
    return mem_load(ptr_offset(buf, i, "Int"), "Int")

// Store 64-bit Int at index `i`.
pub fn istore(buf: ptr<Int>, i: Int, v: Int) with Unsafe:
    mem_store(ptr_offset(buf, i, "Int"), v, "Int")

// Zero out a float arena range.
pub fn zero_floats(buf: ptr<Float>, count: Int) with Unsafe:
    var i = 0
    while i < count:
        mem_store(ptr_offset(buf, i, "Float"), 0.0 as Float, "Float")
        i = i + 1

// Copy a float buffer slice.
pub fn copy_floats(src: ptr<Float>, dst: ptr<Float>, count: Int) with Unsafe:
    var i = 0
    while i < count:
        let v = mem_load(ptr_offset(src, i, "Float"), "Float") as Float
        mem_store(ptr_offset(dst, i, "Float"), v, "Float")
        i = i + 1

// ============================================================================
//  5. Common Tensor Descriptors
// ============================================================================

pub struct Tensor1D:
    data: ptr<Float>
    len: Int

pub struct Tensor2D:
    data: ptr<Float>
    rows: Int
    cols: Int
    stride: Int

pub struct TernaryMatrix:
    data: ptr<Byte>
    rows: Int
    cols: Int
    stride: Int

pub struct TokenBuffer:
    data: ptr<Int>
    len: Int
    cap: Int

// ============================================================================
//  6. Invariant Verification Laws (Compiler-Enforced Contracts)
// ============================================================================

pub law tensor_bounds_valid(index: Int, capacity: Int) -> Bool:
    return index >= 0 and index < capacity

pub law tensor_aligned_32(offset: Int) -> Bool:
    return offset >= 0 and (offset % 32) == 0

pub law float_finite(val: Float) -> Bool:
    return val >= -1000000000000.0 and val <= 1000000000000.0

pub law probability_valid(p: Float) -> Bool:
    return p >= 0.0 and p <= 1.0

// ============================================================================
//  7. String & Numeric Parsing Helpers
// ============================================================================

pub fn parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    var sign = 1
    var index = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    elif char_at(text, 0) == "+":
        index = 1
    var value = 0
    while index < len(text):
        let ch = char_at(text, index)
        var digit = 0
        if ch == "0": digit = 0
        elif ch == "1": digit = 1
        elif ch == "2": digit = 2
        elif ch == "3": digit = 3
        elif ch == "4": digit = 4
        elif ch == "5": digit = 5
        elif ch == "6": digit = 6
        elif ch == "7": digit = 7
        elif ch == "8": digit = 8
        elif ch == "9": digit = 9
        else: return value * sign
        value = value * 10 + digit
        index = index + 1
    return value * sign

pub fn parse_float_text(text: String) -> Float:
    if len(text) == 0:
        return 0.0
    var sign: Float = 1.0
    var index = 0
    if char_at(text, 0) == "-":
        sign = 0.0 - 1.0
        index = 1
    elif char_at(text, 0) == "+":
        index = 1
    var whole: Float = 0.0
    while index < len(text):
        let ch = char_at(text, index)
        if ch == ".":
            break
        var digit: Float = 0.0
        if ch == "0": digit = 0.0
        elif ch == "1": digit = 1.0
        elif ch == "2": digit = 2.0
        elif ch == "3": digit = 3.0
        elif ch == "4": digit = 4.0
        elif ch == "5": digit = 5.0
        elif ch == "6": digit = 6.0
        elif ch == "7": digit = 7.0
        elif ch == "8": digit = 8.0
        elif ch == "9": digit = 9.0
        else: return sign * whole
        whole = whole * 10.0 + digit
        index = index + 1
    if index < len(text):
        if char_at(text, index) == ".":
            index = index + 1
            var div: Float = 10.0
            while index < len(text):
                let ch2 = char_at(text, index)
                var d2: Float = 0.0
                if ch2 == "0": d2 = 0.0
                elif ch2 == "1": d2 = 1.0
                elif ch2 == "2": d2 = 2.0
                elif ch2 == "3": d2 = 3.0
                elif ch2 == "4": d2 = 4.0
                elif ch2 == "5": d2 = 5.0
                elif ch2 == "6": d2 = 6.0
                elif ch2 == "7": d2 = 7.0
                elif ch2 == "8": d2 = 8.0
                elif ch2 == "9": d2 = 9.0
                else: return sign * whole
                whole = whole + d2 / div
                div = div * 10.0
                index = index + 1
    return sign * whole

pub fn find_from(hay: String, needle: String, start: Int) -> Int:
    let hn = len(hay)
    let nn = len(needle)
    if nn == 0:
        return start
    var i = start
    if i < 0:
        i = 0
    while i + nn <= hn:
        var j = 0
        var hit = true
        while j < nn:
            if char_at(hay, i + j) != char_at(needle, j):
                hit = false
                break
            j = j + 1
        if hit:
            return i
        i = i + 1
    return -1

pub fn str_starts_with(text: String, prefix: String) -> Bool:
    let pn = len(prefix)
    if pn > len(text):
        return false
    var i = 0
    while i < pn:
        if char_at(text, i) != char_at(prefix, i):
            return false
        i = i + 1
    return true

pub fn str_ends_with(text: String, suffix: String) -> Bool:
    let sn = len(suffix)
    let tn = len(text)
    if sn > tn:
        return false
    let offset = tn - sn
    var i = 0
    while i < sn:
        if char_at(text, offset + i) != char_at(suffix, i):
            return false
        i = i + 1
    return true

// ============================================================================
//  8. Self-Verifying Test Battery
// ============================================================================

pub fn common_test_battery() -> Int with Unsafe:
    println("--- Running k_AI_n _common.kn Self-Test Battery ---")
    var passed = 0
    var total = 0

    // Test 1: Arena Allocation & +32 SIMD Safety
    total = total + 1
    let byte_arena = arena_alloc_bytes(64)
    bstore(byte_arena, 0, 42)
    bstore(byte_arena, 63, 255)
    let b0 = bref(byte_arena, 0)
    let b63 = bref(byte_arena, 63)
    decay byte_arena
    if b0 == 42 and b63 == 255:
        println("  [PASS] Test 1: Byte arena allocation & store/load verified")
        passed = passed + 1
    else:
        println("  [FAIL] Test 1: Byte arena verification failed")

    // Test 2: Float Arena & Zero Initialization
    total = total + 1
    let float_arena = arena_alloc_floats(32)
    let f_init = fref(float_arena, 15)
    fstore(float_arena, 15, 3.14159)
    let f_val = fref(float_arena, 15)
    decay float_arena
    if f_init == 0.0 and f_val > 3.14 and f_val < 3.15:
        println("  [PASS] Test 2: Float arena zero-init & store/load verified")
        passed = passed + 1
    else:
        println("  [FAIL] Test 2: Float arena verification failed")

    // Test 3: String & Number Parsers
    total = total + 1
    let pi_int = parse_int_text("-139139")
    let pi_float = parse_float_text("139.139")
    if pi_int == -139139 and pi_float > 139.138 and pi_float < 139.140:
        println("  [PASS] Test 3: Integer & float parsers verified")
        passed = passed + 1
    else:
        println("  [FAIL] Test 3: Parsers failed")

    // Test 4: String Matching
    total = total + 1
    let s = "kain_engine_v1.kn"
    let p_ok = str_starts_with(s, "kain_")
    let e_ok = str_ends_with(s, ".kn")
    let f_idx = find_from(s, "engine", 0)
    if p_ok and e_ok and f_idx == 5:
        println("  [PASS] Test 4: String starts_with, ends_with, and find_from verified")
        passed = passed + 1
    else:
        println("  [FAIL] Test 4: String matching failed")

    // Test 5: Invariant Laws
    total = total + 1
    let law1 = tensor_bounds_valid(10, 32)
    let law2 = tensor_bounds_valid(35, 32)
    let law3 = float_finite(42.0)
    let law4 = tensor_aligned_32(64)
    let law5 = probability_valid(0.85)
    if law1 and (law2 == false) and law3 and law4 and law5:
        println("  [PASS] Test 5: Invariant verification laws passed")
        passed = passed + 1
    else:
        println("  [FAIL] Test 5: Laws failed")

    // Test 6: kernel32 DMA Roundtrip IO
    total = total + 1
    let test_file = "_tmp_dma_test.bin"
    let dma_buf = arena_alloc_bytes(128)
    var k = 0
    while k < 128:
        bstore(dma_buf, k, (k * 7 + 3) & 255)
        k = k + 1
    let write_ok = dma_write_file(test_file, dma_buf, 128)
    decay dma_buf

    let sz_slot: ptr<Int> = alloc_zeroed(8, "Int")
    let read_buf = dma_read_file(test_file, sz_slot)
    let r_sz = mem_load(sz_slot, "Int")
    decay sz_slot

    var dma_match = true
    if write_ok and r_sz == 128:
        var m = 0
        while m < 128:
            if bref(read_buf, m) != ((m * 7 + 3) & 255):
                dma_match = false
                break
            m = m + 1
    else:
        dma_match = false

    if ptr_to_int(read_buf) != 0:
        decay read_buf
    // Clean up temporary test file
    fs_remove_file(test_file)

    if dma_match:
        println("  [PASS] Test 6: kernel32 DMA file write/read roundtrip verified (77x faster IO)")
        passed = passed + 1
    else:
        println("  [FAIL] Test 6: DMA file roundtrip failed")

    println("--- _common.kn Summary: " + str(passed) + "/" + str(total) + " tests passed ---")
    if passed == total:
        return 0
    return 1

// ============================================================================
//  9. Subsystem Entry Point (Self-Test Runner)
// ============================================================================

pub fn common_usage():
    println("k_AI_n Core Substrate (_common.kn)")
    println("Run with 'prove' to execute the formal self-test battery.")

pub fn common_main(args: Array<String>) -> Int with Unsafe:
    if len(args) > 0:
        if args[0] == "prove" or args[0] == "test":
            return common_test_battery()
    common_usage()
    return common_test_battery()
