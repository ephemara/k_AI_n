    if df5 < 0.01:
        println("  [PASS] Test 5: End-to-end chain grad matches FD through all layers")
        passed = passed + 1
    else:
        println("  [FAIL] Test 5: Chain composition mismatch")

    println("--- backward Summary: " + str(passed) + "/" + str(total) + " tests passed ---")
    if passed == total:
        return 0
    return 1

// ── Subsystem Entry Point & CLI ─────────────────────────────────────────────

pub fn backward_usage():
    println("k_AI_n Gradient Twins (backward.kn)")
    println("USAGE:")
    println("  core backward prove                Run self-verifying test battery")
    println("  core backward stats                Print twin coverage & FD metrics")

pub fn backward_stats() -> String:
    var t = "=== k_AI_n Gradient Twins (A3) ===\n"
    t = t + "  Twins:        distill-seed, ternary-matvec+STE, rmsnorm,\n"
    t = t + "                swiglu, ssm-BPTT-step, residual-split\n"
    t = t + "  Proof:        central finite differences, e=1e-4, tol=1e-3\n"
    t = t + "  STE rule:     dLdW_float = dLdy*x (optimizer shadow, by formula)\n"
    t = t + "  Allocations:  0 in kernels (caller-owned grad buffers, overwrite)\n"
    return t

pub fn backward_main(args: Array<String>) -> Int with Unsafe:
    if len(args) == 0:
        backward_usage()
        return 0
    let cmd = args[0]
    if cmd == "prove" or cmd == "test":
        return backward_test_battery()
    elif cmd == "stats":
        println(backward_stats())
        return 0
    else:
        backward_usage()
        return 0

// ============================================================================
// binary_packer.kn
// ============================================================================
// ============================================================================
//  k_AI_n :: binary_packer.kn — Contiguous 64-Byte Aligned .kain_bin Packager
// ============================================================================
//  Subsystem 6: Scavenger Refinery & Distillation (training forge feed)
//  Architecture:
//    - The `.kain_bin` training stream: ONE contiguous arena, 64-byte aligned
//      records, laid out for zero-copy DMA into the forge:
//        bytes 0..7:    magic "KAINBIN1" (75,65,73,78,66,73,78,49)
//        bytes 8..15:   version u64 LE (=1)
//        bytes 16..23:  dim (sequence length) u64 LE
//        bytes 24..31:  count (number of sequences) u64 LE
//        per record:    dim token u16 LE (dim*2 bytes, fits 16k vocab)
//                       + dim mask bytes (1 = invariant pointer/bounds/type)
//                       + zero padding up to 64-byte multiple
//        record stride = round64(dim * 3)
//    - THE forge-feed glue (buffer contract, no serialization):
//        tokenizer tokenize_into_arena(text) -> token IDs
//        bin_pack_record(buf, ...)          -> contiguous .kain_bin arena
//        _common dma_write_file(path, buf)  -> train.kain_bin on disk (77x DMA,
//                                             proven 6/6 in _common.kn)
//        _common dma_read_file(path)        -> arena back in RAM
//        bin_unpack_record(...)             -> rows for distil_loss_batch
//      Packer owns LAYOUT ONLY; _common owns BYTES-ON-DISK. Zero overlap.
//
//  GLUE CONTRACT (Amalgamation Charter Law 1):
//    - NEVER redefines _common.kn symbols (arenas, bref/bstore, DMA, Tensor*).
//    - NEVER redefines gemm/activations/ssm/distill symbols.
//    - All new symbols use BIN_ prefix or bin_ scope.
//    - Leaf-module discipline: raw mem_load/mem_store/ptr_offset builtins only
//      (same as gemm_158b's packed-2b codec) so standalone check stays hermetic.
// ============================================================================

use std::runtime

// ── Format Constants (BIN_ scoped, no collisions) ───────────────────────────

pub const BIN_VERSION: Int = 1
pub const BIN_ALIGN: Int = 64
pub const BIN_HEADER_LEN: Int = 32
pub const BIN_M0: Int = 75
pub const BIN_M1: Int = 65
pub const BIN_M2: Int = 73
pub const BIN_M3: Int = 78
pub const BIN_M4: Int = 66
pub const BIN_M5: Int = 73
pub const BIN_M6: Int = 78
pub const BIN_M7: Int = 49
pub const BIN_VOCAB_MAX: Int = 16383

// ── Invariant Laws (uniquely named) ─────────────────────────────────────────

pub law bin_dims_valid(dim: Int) -> Bool:
    return dim > 0 and (dim % 8) == 0

pub law bin_count_valid(n: Int) -> Bool:
    return n > 0 and n <= 1000000

pub law bin_stride_aligned(stride: Int) -> Bool:
    return stride > 0 and (stride % 64) == 0

// ── Layout Arithmetic ───────────────────────────────────────────────────────

// Record stride: dim u16 tokens + dim mask bytes, rounded up to 64.
pub fn bin_record_stride(dim: Int) -> Int with Pure:
    let raw = dim * 3
    return ((raw + BIN_ALIGN - 1) / BIN_ALIGN) * BIN_ALIGN

// Total stream bytes for count sequences of dim tokens.
pub fn bin_stream_bytes(dim: Int, count: Int) -> Int with Pure:
    return BIN_HEADER_LEN + count * bin_record_stride(dim)

// ── Little-Endian u64 Codec (header fields) ─────────────────────────────────

pub fn bin_write_u64(buf: ptr<Byte>, off: Int, v: Int) -> Int with Unsafe:
    var shift = 0
    var i = 0
    while i < 8:
        let byte_v = (v >> shift) & 255
        mem_store(ptr_offset(buf, off + i, "Byte"), byte_v as Byte, "Byte")
        shift = shift + 8
        i = i + 1
    return 0

pub fn bin_read_u64(buf: ptr<Byte>, off: Int) -> Int with Unsafe:
    var acc = 0
    var shift = 0
    var i = 0
    while i < 8:
        let byte_v = mem_load(ptr_offset(buf, off + i, "Byte"), "Int") & 255
        acc = acc + (byte_v << shift)
        shift = shift + 8
        i = i + 1
    return acc

// ── Header Write / Validate ─────────────────────────────────────────────────

pub fn bin_write_header(buf: ptr<Byte>, dim: Int, count: Int) -> Int with Unsafe:
    mem_store(ptr_offset(buf, 0, "Byte"), BIN_M0 as Byte, "Byte")
    mem_store(ptr_offset(buf, 1, "Byte"), BIN_M1 as Byte, "Byte")
    mem_store(ptr_offset(buf, 2, "Byte"), BIN_M2 as Byte, "Byte")
    mem_store(ptr_offset(buf, 3, "Byte"), BIN_M3 as Byte, "Byte")
    mem_store(ptr_offset(buf, 4, "Byte"), BIN_M4 as Byte, "Byte")
    mem_store(ptr_offset(buf, 5, "Byte"), BIN_M5 as Byte, "Byte")
    mem_store(ptr_offset(buf, 6, "Byte"), BIN_M6 as Byte, "Byte")
    mem_store(ptr_offset(buf, 7, "Byte"), BIN_M7 as Byte, "Byte")
    bin_write_u64(buf, 8, BIN_VERSION)
    bin_write_u64(buf, 16, dim)
    bin_write_u64(buf, 24, count)
    return 0

// Returns 0 if valid (writes dim/count out), else error code:
// 1 = bad magic, 2 = bad version, 3 = buffer too small for claimed shape.
pub fn bin_validate_header(buf: ptr<Byte>, nbytes: Int, out_dim: ptr<Int>, out_count: ptr<Int>) -> Int with Unsafe:
    if (mem_load(ptr_offset(buf, 0, "Byte"), "Int") & 255) != BIN_M0:
        return 1
    if (mem_load(ptr_offset(buf, 1, "Byte"), "Int") & 255) != BIN_M1:
        return 1
    if (mem_load(ptr_offset(buf, 2, "Byte"), "Int") & 255) != BIN_M2:
        return 1
    if (mem_load(ptr_offset(buf, 3, "Byte"), "Int") & 255) != BIN_M3:
        return 1
    if (mem_load(ptr_offset(buf, 4, "Byte"), "Int") & 255) != BIN_M4:
        return 1
    if (mem_load(ptr_offset(buf, 5, "Byte"), "Int") & 255) != BIN_M5:
        return 1
    if (mem_load(ptr_offset(buf, 6, "Byte"), "Int") & 255) != BIN_M6:
        return 1
    if (mem_load(ptr_offset(buf, 7, "Byte"), "Int") & 255) != BIN_M7:
        return 1
    let ver = bin_read_u64(buf, 8)
    if ver != BIN_VERSION:
        return 2
    let dim = bin_read_u64(buf, 16)
    let count = bin_read_u64(buf, 24)
    if bin_stream_bytes(dim, count) > nbytes:
        return 3
    mem_store(out_dim, dim, "Int")
    mem_store(out_count, count, "Int")
    return 0

// ── Record Pack / Unpack (u16 tokens + mask bytes, zero-padded to stride) ───

pub fn bin_pack_record(buf: ptr<Byte>, base: Int, tokens: ptr<Int>, mask: ptr<Byte>, dim: Int) -> Int with Unsafe:
    let tok_base = base
    let msk_base = base + dim * 2
    var i = 0
    while i < dim:
        let tok = mem_load(ptr_offset(tokens, i, "Int"), "Int")
        let t_lo = tok_base + i * 2
        mem_store(ptr_offset(buf, t_lo, "Byte"), (tok & 255) as Byte, "Byte")
        let t_hi = tok_base + i * 2 + 1
        mem_store(ptr_offset(buf, t_hi, "Byte"), ((tok >> 8) & 255) as Byte, "Byte")
        i = i + 1
    var j = 0
    while j < dim:
        let m_at = msk_base + j
        let msrc = mem_load(ptr_offset(mask, j, "Byte"), "Int") & 255
        mem_store(ptr_offset(buf, m_at, "Byte"), msrc as Byte, "Byte")
        j = j + 1
    let stride = bin_record_stride(dim)
    let pad_end = base + stride
    var p = base + dim * 3
    while p < pad_end:
        mem_store(ptr_offset(buf, p, "Byte"), 0 as Byte, "Byte")
        p = p + 1
    return 0

pub fn bin_unpack_record(tokens_out: ptr<Int>, mask_out: ptr<Byte>, buf: ptr<Byte>, base: Int, dim: Int) -> Int with Unsafe:
    let tok_base = base
    let msk_base = base + dim * 2
    var i = 0
    while i < dim:
        let t_lo = tok_base + i * 2
        let lo = mem_load(ptr_offset(buf, t_lo, "Byte"), "Int") & 255
        let t_hi = tok_base + i * 2 + 1
        let hi = mem_load(ptr_offset(buf, t_hi, "Byte"), "Int") & 255
        mem_store(ptr_offset(tokens_out, i, "Int"), lo + hi * 256, "Int")
        let m_at = msk_base + i
        mem_store(ptr_offset(mask_out, i, "Byte"), (mem_load(ptr_offset(buf, m_at, "Byte"), "Int") & 255) as Byte, "Byte")
        i = i + 1
    return 0

// Pack a full batch: row b lives at header + b * stride (row-major for distill).
pub fn bin_pack_batch(buf: ptr<Byte>, tokens_b: ptr<Int>, mask_b: ptr<Byte>, batch: Int, dim: Int) -> Int with Unsafe:
    bin_write_header(buf, dim, batch)
    let stride = bin_record_stride(dim)
    var b = 0
    while b < batch:
        let base = BIN_HEADER_LEN + b * stride
        let t_row = ptr_offset(tokens_b, b * dim, "Int")
        let m_row = ptr_offset(mask_b, b * dim, "Byte")
        bin_pack_record(buf, base, t_row, m_row, dim)
        b = b + 1
    return 0

// ── Self-Verifying Test Battery ─────────────────────────────────────────────

pub fn binpack_test_battery() -> Int with Unsafe:
    println("--- Running k_AI_n binary_packer Self-Test Battery ---")
    var passed = 0
    var total = 0

    // Test 1: Header write + validate roundtrip; corrupted magic rejected.
    total = total + 1
    let dim1 = 8
    let cnt1 = 2
    let nb1 = bin_stream_bytes(dim1, cnt1)
    let buf1: ptr<Byte> = alloc_zeroed(256, "Byte")
    bin_write_header(buf1, dim1, cnt1)
    let od1: ptr<Int> = alloc_zeroed(8, "Int")
    let oc1: ptr<Int> = alloc_zeroed(8, "Int")
    let rc_ok = bin_validate_header(buf1, nb1, od1, oc1)
    let got_dim = mem_load(od1, "Int")
    let got_cnt = mem_load(oc1, "Int")
    mem_store(ptr_offset(buf1, 0, "Byte"), 0 as Byte, "Byte")
    let rc_bad = bin_validate_header(buf1, nb1, od1, oc1)
    decay buf1
    decay od1
    decay oc1
    if rc_ok == 0 and got_dim == dim1 and got_cnt == cnt1 and rc_bad == 1:
        println("  [PASS] Test 1: Header roundtrip valid, corrupted magic rejected")
        passed = passed + 1
    else:
        println("  [FAIL] Test 1: Header mismatch")

    // Test 2: Record pack/unpack roundtrip incl. edge token values.
    total = total + 1
    let dim2 = 8
    let stride2 = bin_record_stride(dim2)
    let buf2: ptr<Byte> = alloc_zeroed(256, "Byte")
    let tok2: ptr<Int> = alloc_zeroed(64, "Int")
    let msk2: ptr<Byte> = alloc_zeroed(64, "Byte")
    let tok2b: ptr<Int> = alloc_zeroed(64, "Int")
    let msk2b: ptr<Byte> = alloc_zeroed(64, "Byte")
    mem_store(ptr_offset(tok2, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(tok2, 1, "Int"), 16383, "Int")
    mem_store(ptr_offset(tok2, 2, "Int"), 255, "Int")
    mem_store(ptr_offset(tok2, 3, "Int"), 256, "Int")
    mem_store(ptr_offset(tok2, 4, "Int"), 334, "Int")
    mem_store(ptr_offset(msk2, 1, "Byte"), 1 as Byte, "Byte")
    mem_store(ptr_offset(msk2, 4, "Byte"), 1 as Byte, "Byte")
    bin_pack_record(buf2, 0, tok2, msk2, dim2)
    bin_unpack_record(tok2b, msk2b, buf2, 0, dim2)
    let r1 = mem_load(ptr_offset(tok2b, 1, "Int"), "Int")
    let r4 = mem_load(ptr_offset(tok2b, 4, "Int"), "Int")
    let r0 = mem_load(ptr_offset(tok2b, 0, "Int"), "Int")
    let rm1 = mem_load(ptr_offset(msk2b, 1, "Byte"), "Int") & 255
    let rm0 = mem_load(ptr_offset(msk2b, 0, "Byte"), "Int") & 255
    decay buf2
    decay tok2
    decay msk2
    decay tok2b
    decay msk2b
    if r1 == 16383 and r4 == 334 and r0 == 0 and rm1 == 1 and rm0 == 0 and stride2 == 64:
        println("  [PASS] Test 2: Record roundtrip exact (edge tokens + mask, stride 64)")
        passed = passed + 1
    else:
        println("  [FAIL] Test 2: Record mismatch")

    // Test 3: Batch pack — row 1 lands at header + stride, header validates.
    total = total + 1
    let dim3 = 8
    let batch3 = 2
    let stride3 = bin_record_stride(dim3)
    let nb3 = bin_stream_bytes(dim3, batch3)
    let buf3: ptr<Byte> = alloc_zeroed(256, "Byte")
    let tok3: ptr<Int> = alloc_zeroed(64, "Int")
    let msk3: ptr<Byte> = alloc_zeroed(64, "Byte")
    mem_store(ptr_offset(tok3, 8 + 0, "Int"), 7777, "Int")
    mem_store(ptr_offset(msk3, 8 + 0, "Byte"), 1 as Byte, "Byte")
    bin_pack_batch(buf3, tok3, msk3, batch3, dim3)
    let od3: ptr<Int> = alloc_zeroed(8, "Int")
    let oc3: ptr<Int> = alloc_zeroed(8, "Int")
    let rc3 = bin_validate_header(buf3, nb3, od3, oc3)
    let row1base = BIN_HEADER_LEN + stride3
    let r1lo = mem_load(ptr_offset(buf3, row1base, "Byte"), "Int") & 255
    let r1hi = mem_load(ptr_offset(buf3, row1base + 1, "Byte"), "Int") & 255
    let r1tok = r1lo + r1hi * 256
    let r1m = mem_load(ptr_offset(buf3, row1base + dim3 * 2, "Byte"), "Int") & 255
    let r0lo = mem_load(ptr_offset(buf3, BIN_HEADER_LEN, "Byte"), "Int") & 255
    decay buf3
    decay tok3
    decay msk3
    decay od3
    decay oc3
    if rc3 == 0 and r1tok == 7777 and r1m == 1 and r0lo == 0 and nb3 == 32 + 2 * 64:
        println("  [PASS] Test 3: Batch rows land on stride boundaries, header validates")
        passed = passed + 1
    else:
        println("  [FAIL] Test 3: Batch layout mismatch")

    // Test 4: u64 codec roundtrip on large dim/count values.
    total = total + 1
    let buf4: ptr<Byte> = alloc_zeroed(64, "Byte")
    bin_write_u64(buf4, 0, 8192)
    bin_write_u64(buf4, 8, 50000)
    let v0 = bin_read_u64(buf4, 0)
    let v1 = bin_read_u64(buf4, 8)
    decay buf4
    if v0 == 8192 and v1 == 50000:
        println("  [PASS] Test 4: u64 LE codec roundtrip verified (8192, 50000)")
        passed = passed + 1
    else:
        println("  [FAIL] Test 4: u64 codec mismatch")

    // Test 5: Invariant laws (dims, count, stride alignment).
    total = total + 1
    let l1 = bin_dims_valid(64)
    let l2 = bin_dims_valid(63)
    let l3 = bin_count_valid(1000)
    let l4 = bin_count_valid(0)
    let l5 = bin_stride_aligned(bin_record_stride(8))
    let l6 = bin_stride_aligned(63)
    if l1 and (l2 == false) and l3 and (l4 == false) and l5 and (l6 == false):
        println("  [PASS] Test 5: Packer dimension, count & alignment laws passed")
        passed = passed + 1
    else:
        println("  [FAIL] Test 5: Invariant laws failed")

    println("--- binary_packer Summary: " + str(passed) + "/" + str(total) + " tests passed ---")
    if passed == total:
        return 0
    return 1

// ── Subsystem Entry Point & CLI ─────────────────────────────────────────────

pub fn binpack_usage():
    println("k_AI_n .kain_bin Packager (binary_packer.kn)")
    println("USAGE:")
    println("  core pack prove                    Run self-verifying test battery")
    println("  core pack stats                    Print stream format & stride metrics")

pub fn binpack_stats() -> String:
    var t = "=== k_AI_n .kain_bin Training Stream ===\n"
    t = t + "  Header:       32B magic KAINBIN1 + version/dim/count u64 LE\n"
    t = t + "  Record:       dim u16 tokens + dim mask bytes, padded to 64B\n"
    t = t + "  Stride(dim8): 64B (dim*3=24, rounded to 64 for cache lines)\n"
    t = t + "  Vocab:        u16 tokens cover full 16k range (0..16383)\n"
    t = t + "  Persistence:  arena -> dma_write_file -> train.kain_bin (77x DMA)\n"
    t = t + "  Allocations:  0 in hot path (caller-owned arenas, in-place codec)\n"
    return t

pub fn binpack_main(args: Array<String>) -> Int with Unsafe:
    if len(args) == 0:
        binpack_usage()
        return 0
    let cmd = args[0]
    if cmd == "prove" or cmd == "test":
        return binpack_test_battery()
    elif cmd == "stats":
        println(binpack_stats())
        return 0
    else:
        binpack_usage()
        return 0

// ============================================================================
// config.kn
// ============================================================================
// ============================================================================
//  k_AI_n :: config.kn — Architecture Hyperparameters & Hardware Probes
// ============================================================================
//  Subsystem 1: Core Host Runtime, Memory & CLI
//  Architecture:
//    - THE single source of truth for every threshold and dimension in the
//      engine (AGENTS.md Rule 5: no magic numbers scattered in logic loops).
//    - Two named presets as flat const groups (no heap structs, no globals):
//        Step-0 (S0): 150M proof-of-life ..... dim 1024, state 128, 12 layers
//        Step-1 (S1): 1.5B scavenger coder .... dim 2048, state 128, 24 layers
//      Scaling the engine = reading the other const group, never a rewrite.
//    - Honest census + footprint estimators (documented formulas, tested ranges)
//      so VRAM claims are receipts, not wishes.
//    - Contract test: our literals agree with peer modules (16384 vocab with
//      tokenizer_16k, 5.0 invariant weight with distill_loss, 64B align with
//      binary_packer). Standalone-safe: literals duplicated, never imported.
//
//  GLUE CONTRACT (Amalgamation Charter Law 1):
//    - NEVER redefines _common/gemm/activations/ssm/distill/packer symbols.
//    - All new symbols use CFG_ prefix or cfg_ scope. Pure functions only
//      (no arenas, no effects) — check-hermetic by construction.
// ============================================================================

use std::runtime

// ── Shared Vocabulary & Stream Contract ─────────────────────────────────────

pub const CFG_VOCAB_SIZE: Int = 16384
pub const CFG_PACK_ALIGN: Int = 64
pub const CFG_INVARIANT_W: Float = 5.0

// ── Step-0 Preset: 150M Proof of Alien Life ─────────────────────────────────

pub const CFG_S0_DIM: Int = 1024
pub const CFG_S0_STATE_DIM: Int = 128
pub const CFG_S0_LAYERS: Int = 24
pub const CFG_S0_SEQ: Int = 2048
pub const CFG_S0_BATCH: Int = 8

// ── Step-1 Preset: 1.5B Scavenger Coder ─────────────────────────────────────

pub const CFG_S1_DIM: Int = 3072
pub const CFG_S1_STATE_DIM: Int = 128
pub const CFG_S1_LAYERS: Int = 32
pub const CFG_S1_SEQ: Int = 2048
pub const CFG_S1_BATCH: Int = 4

// ── Training Hyperparameters (Adam + Distillation) ──────────────────────────

pub const CFG_LR: Float = 0.001
pub const CFG_ADAM_B1: Float = 0.9
pub const CFG_ADAM_B2: Float = 0.999
pub const CFG_ADAM_EPS: Float = 0.00000001
pub const CFG_TEMP: Float = 1.0
pub const CFG_TERNARY_THRESHOLD: Float = 0.05
pub const CFG_SSM_DT: Float = 0.1
pub const CFG_RMS_EPS: Float = 0.000001
pub const CFG_ROPE_THETA: Float = 10000.0

// ── Invariant Laws (uniquely named) ─────────────────────────────────────────

pub law cfg_dims_valid(dim: Int, state_dim: Int, layers: Int) -> Bool:
    return dim > 0 and (dim % 8) == 0 and state_dim > 0 and layers > 0 and layers <= 128

pub law cfg_train_valid(vocab: Int, seq: Int, batch: Int) -> Bool:
    return vocab == CFG_VOCAB_SIZE and seq > 0 and (seq % 256) == 0 and batch > 0 and batch <= 64

pub law cfg_opt_valid(lr: Float, b1: Float, b2: Float) -> Bool:
    return lr > 0.0 and lr < 1.0 and b1 > 0.0 and b1 < 1.0 and b2 > 0.0 and b2 < 1.0 and b1 < b2

// ── Census & Footprint Estimators ───────────────────────────────────────────

// Honest parameter census for our hybrid block:
//   embed        = vocab * dim
//   per layer    = 4*d*d (ternary QKV+O / gate+proj) + 3*state_dim (SSM A,B,C)
//                  + 3*d (SSM skip/output + 2 RMSNorm gammas)
//   head         = dim * vocab (untied upper bound) + dim (final norm)
// Returns total trainable parameters.
pub fn cfg_census(dim: Int, state_dim: Int, layers: Int, vocab: Int) -> Int with Pure:
    let embed = vocab * dim
    let per_layer = 4 * dim * dim + 3 * state_dim + 3 * dim
    let head = dim * vocab + dim
    return embed + layers * per_layer + head

// Ternary weight footprint in bytes: ternary matrices at 2 bits/param
// (params/4) + embedding + head kept at fp16 (2 bytes/param).
pub fn cfg_footprint_bytes(dim: Int, state_dim: Int, layers: Int, vocab: Int) -> Int with Pure:
    let ternary_params = layers * (4 * dim * dim + 3 * state_dim)
    let fp16_params = 2 * vocab * dim + layers * 3 * dim + dim
    return ternary_params / 4 + fp16_params * 2

// Recurrent state bytes (fixed O(1) memory): layers * state_dim * dim fp32.
pub fn cfg_state_bytes(dim: Int, state_dim: Int, layers: Int) -> Int with Pure:
    return layers * state_dim * dim * 4

// ── Preset Validators ──────────────────────────────────────────────────────

pub fn cfg_step0_valid() -> Bool with Pure:
    return cfg_dims_valid(CFG_S0_DIM, CFG_S0_STATE_DIM, CFG_S0_LAYERS)

pub fn cfg_step1_valid() -> Bool with Pure:
    return cfg_dims_valid(CFG_S1_DIM, CFG_S1_STATE_DIM, CFG_S1_LAYERS)

pub fn cfg_opt_default_valid() -> Bool with Pure:
    return cfg_opt_valid(CFG_LR, CFG_ADAM_B1, CFG_ADAM_B2)

// ── Self-Verifying Test Battery ─────────────────────────────────────────────

pub fn config_test_battery() -> Int with Unsafe:
    println("--- Running k_AI_n config Self-Test Battery ---")
    var passed = 0
    var total = 0

    // Test 1: Step-0 census lands in the 150M-class band (formula documented above).
    total = total + 1
    let n0 = cfg_census(CFG_S0_DIM, CFG_S0_STATE_DIM, CFG_S0_LAYERS, CFG_VOCAB_SIZE)
    if n0 > 120000000 and n0 < 180000000:
        println("  [PASS] Test 1: Step-0 census 150M-class (" + str(n0) + " params)")
        passed = passed + 1
    else:
        println("  [FAIL] Test 1: Step-0 census out of band (got " + str(n0) + ")")

    // Test 2: Step-1 census is 1B-class and strictly larger than Step-0.
    total = total + 1
    let n1 = cfg_census(CFG_S1_DIM, CFG_S1_STATE_DIM, CFG_S1_LAYERS, CFG_VOCAB_SIZE)
    if n1 > 800000000 and n1 < 2200000000 and n1 > n0:
        println("  [PASS] Test 2: Step-1 census 1.5B-class (" + str(n1) + " params)")
        passed = passed + 1
    else:
        println("  [FAIL] Test 2: Step-1 census out of band (got " + str(n1) + ")")

    // Test 3: Footprint receipts — Step-0 weights + state fit tiny caps.
    total = total + 1
    let f0 = cfg_footprint_bytes(CFG_S0_DIM, CFG_S0_STATE_DIM, CFG_S0_LAYERS, CFG_VOCAB_SIZE)
    let s0 = cfg_state_bytes(CFG_S0_DIM, CFG_S0_STATE_DIM, CFG_S0_LAYERS)
    if f0 > 0 and f0 < 200000000 and s0 > 0 and s0 < 20000000:
        println("  [PASS] Test 3: Step-0 footprint weights=" + str(f0) + "B state=" + str(s0) + "B")
        passed = passed + 1
    else:
        println("  [FAIL] Test 3: Footprint out of cap")

    // Test 4: Preset + optimizer laws accept truth, reject garbage.
    total = total + 1
    let v0 = cfg_step0_valid()
    let v1 = cfg_step1_valid()
    let vopt = cfg_opt_default_valid()
    let bad_dim = cfg_dims_valid(1001, 128, 12)
    let bad_layers = cfg_dims_valid(1024, 128, 0)
    let bad_lr = cfg_opt_valid(2.0, 0.9, 0.999)
    let bad_beta = cfg_opt_valid(0.001, 0.999, 0.9)
    let bad_train = cfg_train_valid(16384, 100, 8)
    if v0 and v1 and vopt and (bad_dim == false) and (bad_layers == false) and (bad_lr == false) and (bad_beta == false) and (bad_train == false):
        println("  [PASS] Test 4: Preset, optimizer & training-shape laws passed")
        passed = passed + 1
    else:
        println("  [FAIL] Test 4: Validator laws failed")

    // Test 5: Cross-module contract — our literals agree with peer modules.
    total = total + 1
    let c_vocab = CFG_VOCAB_SIZE == 16384
    let c_w = CFG_INVARIANT_W > 4.999 and CFG_INVARIANT_W < 5.001
    let c_align = CFG_PACK_ALIGN == 64
    let c_theta = CFG_ROPE_THETA > 9999.0 and CFG_ROPE_THETA < 10001.0
    let c_eps = CFG_RMS_EPS > 0.0 and CFG_RMS_EPS < 0.001
    if c_vocab and c_w and c_align and c_theta and c_eps:
        println("  [PASS] Test 5: Contract agrees with tokenizer/distill/packer/RoPE literals")
        passed = passed + 1
    else:
        println("  [FAIL] Test 5: Contract literal mismatch")

    println("--- config Summary: " + str(passed) + "/" + str(total) + " tests passed ---")
    if passed == total:
        return 0
    return 1

// ── Subsystem Entry Point & CLI ─────────────────────────────────────────────

pub fn config_usage():
    println("k_AI_n Architecture Config (config.kn)")
    println("USAGE:")
    println("  core config prove                  Run self-verifying test battery")
    println("  core config stats                  Print census & footprint metrics")
    println("  core config show                   Print both preset tables")

pub fn config_stats() -> String:
    var t = "=== k_AI_n Architecture Config ===\n"
    t = t + "  Step-0 150M:  dim=1024 state=128 layers=24 seq=2048 batch=8\n"
    t = t + "  Step-1 1.5B:  dim=3072 state=128 layers=32 seq=2048 batch=4\n"
    t = t + "  Vocab:        16384 (matches tokenizer_16k)\n"
    t = t + "  Optimizer:    Adam lr=0.001 b1=0.9 b2=0.999 eps=1e-8\n"
    t = t + "  Distill:      5.0x invariant weight (matches distill_loss)\n"
    t = t + "  Stream:       64B records (matches binary_packer)\n"
    return t

pub fn config_show() -> String:
    var t = "--- Step-0 150M Proof of Alien Life ---\n"
    t = t + "  census=" + str(cfg_census(CFG_S0_DIM, CFG_S0_STATE_DIM, CFG_S0_LAYERS, CFG_VOCAB_SIZE)) + "\n"
    t = t + "  weights=" + str(cfg_footprint_bytes(CFG_S0_DIM, CFG_S0_STATE_DIM, CFG_S0_LAYERS, CFG_VOCAB_SIZE)) + "B\n"
    t = t + "  state=" + str(cfg_state_bytes(CFG_S0_DIM, CFG_S0_STATE_DIM, CFG_S0_LAYERS)) + "B\n"
    t = t + "--- Step-1 1.5B Scavenger Coder ---\n"
    t = t + "  census=" + str(cfg_census(CFG_S1_DIM, CFG_S1_STATE_DIM, CFG_S1_LAYERS, CFG_VOCAB_SIZE)) + "\n"
    t = t + "  weights=" + str(cfg_footprint_bytes(CFG_S1_DIM, CFG_S1_STATE_DIM, CFG_S1_LAYERS, CFG_VOCAB_SIZE)) + "B\n"
    t = t + "  state=" + str(cfg_state_bytes(CFG_S1_DIM, CFG_S1_STATE_DIM, CFG_S1_LAYERS)) + "B\n"
    return t

pub fn config_main(args: Array<String>) -> Int with Unsafe:
    if len(args) == 0:
        config_usage()
        return 0
    let cmd = args[0]
    if cmd == "prove" or cmd == "test":
        return config_test_battery()
    elif cmd == "stats":
        println(config_stats())
        return 0
    elif cmd == "show":
        println(config_show())
        return 0
    else:
        config_usage()
        return 0

