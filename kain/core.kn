// -- KAIN RAW AMALGAMATION -- core ----------------------------------------------------------
// kind:       directory
// contents:   source
// structure:  12 files | 12 modules
//
// -- PUBLIC INTERFACE DIRECTORY -----------------------------------------------
//
// [functions]
//   fn main() -> Int with Unsafe
//   fn match_merge_at(text: String, pos: Int) -> Array<Int>
