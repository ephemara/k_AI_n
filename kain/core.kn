    decay dcc
    decay dbb
    decay daa
    decay dkk
    decay dgm
    decay dga
    decay dgb
    decay dha
    decay dhb
    let df5 = ana0 - (lp5 - lm5) / (2.0 * e)
    if df5 < 0.0:
